<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GitLlama.Desktop.Views"
             x:Class="GitLlama.Desktop.Views.NavigationView">
    <Border Background="{StaticResource SidebarBrush}"
            BorderBrush="#393E47"
            BorderThickness="1"
            CornerRadius="6">
        <ScrollViewer AllowAutoHide="True"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,8,20,8" Spacing="3">
                <TextBox Watermark="Filter branches…"
                         Text="{Binding BranchSearch}"
                         Margin="0,0,0,8" />

                <Border Classes="category">
                    <Expander Classes="navigation" IsExpanded="True">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Local branches" VerticalAlignment="Center" />

                                <Button x:Name="CreateBranchButton"
                                        Grid.Column="1"
                                        Classes="workspace toolbar"
                                        Content="＋"
                                        Click="CreateBranch_Click"
                                        IsEnabled="{Binding HasRepository}"
                                        ToolTip.Tip="Create a branch from the current commit"
                                        Padding="6,0"
                                        MinHeight="0" />
                            </Grid>
                        </Expander.Header>

                        <ListBox Classes="branch-list"
                                 ItemsSource="{Binding LocalBranches}"
                                 SelectedItem="{Binding SelectedBranchLine, Mode=OneWay}"
                                 SelectionChanged="Branch_SelectionChanged"
                                 ContextRequested="BranchContextRequested"
                                 Tapped="Branch_Tapped"
                                 DoubleTapped="Branch_DoubleTapped"
                                 MaxHeight="230">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="20,*"
                                          ColumnSpacing="4"
                                          Margin="12,0,0,0"
                                          ToolTip.Tip="{Binding}">
                                        <Path Data="M 5,4 L 5,14 M 5,10 C 5,6 14,10 14,4 M 5,1 A 2,2 0 1 0 5,5 A 2,2 0 1 0 5,1 M 14,1 A 2,2 0 1 0 14,5 A 2,2 0 1 0 14,1 M 5,13 A 2,2 0 1 0 5,17 A 2,2 0 1 0 5,13"
                                              Width="14"
                                              Height="14"
                                              Stretch="Uniform"
                                              Stroke="#AAB2BF"
                                              StrokeThickness="1.4"
                                              VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation" IsExpanded="True">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Remotes" VerticalAlignment="Center" />

                                <Button x:Name="AddRemoteButton"
                                        Grid.Column="1"
                                        Classes="workspace toolbar"
                                        Content="＋"
                                        Click="AddRemote_Click"
                                        IsEnabled="{Binding HasRepository}"
                                        ToolTip.Tip="Add a remote"
                                        Padding="6,0"
                                        MinHeight="0" />
                            </Grid>
                        </Expander.Header>

                        <views:RemoteTreeView MaxHeight="300" />
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Tags"
                              IsExpanded="False">
                        <StackPanel Spacing="4">
                            <ListBox ItemsSource="{Binding Tags}"
                                     SelectedItem="{Binding SelectedTag}"
                                     ContextRequested="TagContextRequested"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Classes="workspace toolbar"
                                    Content="＋ Create tag…"
                                    Click="CreateTag_Click"
                                    HorizontalContentAlignment="Left" />

                            <Button Classes="workspace toolbar"
                                    Content="＋ Annotated tag…"
                                    Click="CreateAnnotatedTag_Click"
                                    HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Stashes"
                              IsExpanded="True">

                        <StackPanel>
                            <TreeView x:Name="StashTreeControl"
                                      ItemsSource="{Binding StashTree}"
                                      SelectionChanged="Stash_SelectionChanged"
                                      Tapped="Stash_Tapped"
                                      ContextRequested="StashContextRequested"
                                      IsVisible="{Binding HasStashes}"
                                      MaxHeight="260">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="Padding" Value="2,4" />
                                    </Style>
                                </TreeView.Styles>

                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children}">
                                        <Grid ColumnDefinitions="20,*,Auto"
                                              ColumnSpacing="4"
                                              ToolTip.Tip="{Binding Tooltip}">
                                            <Path Data="{Binding IconPath}"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Stroke="#AAB2BF"
                                                  StrokeThickness="1.4"
                                                  VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Count}"
                                                       Classes="muted"
                                                       FontSize="11"
                                                       Margin="8,0,4,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <TextBlock Text="No stashes. Use the Stash tab under your working changes to set changes aside."
                                       Classes="muted"
                                       FontSize="11"
                                       Margin="8,4"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !HasStashes}" />
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Worktrees"
                              IsExpanded="False">
                        <Button Classes="workspace toolbar"
                                Content="View worktrees…"
                                Click="Worktrees_Click"
                                HorizontalContentAlignment="Left" />
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander x:Name="PullRequestCategory" Classes="navigation" IsExpanded="False"
                              Expanded="PullRequests_Expanded">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="Pull requests" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PullRequestCount}" Classes="muted" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="workspace toolbar" Content="↻"
                                    Command="{Binding RefreshPullRequestsCommand}" Padding="6,0" MinHeight="0" IsEnabled="{Binding !IsHostingBusy}"
                                        ToolTip.Tip="Refresh pull requests" />
                            </Grid>
                        </Expander.Header>
                        <Grid RowDefinitions="Auto,*,Auto" MaxHeight="360">
                            <Grid ColumnDefinitions="*,80" ColumnSpacing="4">
                                <TextBox x:Name="PullRequestSearchBox" Text="{Binding PullRequestSearch}" Watermark="Search pull requests…" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding HostingStates}" SelectedItem="{Binding HostingState}"
                                          ToolTip.Tip="Pull request state across this repository's GitHub remotes" />
                            </Grid>
                            <TreeView x:Name="PullRequestTree" ItemsSource="{Binding PullRequestTree}"
                                      Grid.Row="1"
                                      SelectedItem="{Binding SelectedPullRequestNode, Mode=TwoWay}"
                                      ContextRequested="PullRequestContextRequested" Margin="0,6,8,4" MinHeight="70"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="Padding" Value="2,2" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5" ToolTip.Tip="{Binding Tooltip}">
                                            <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="muted" FontSize="11"
                                                       Margin="4,0,4,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <StackPanel Grid.Row="2" Spacing="4">
                            <Button Classes="workspace toolbar" Content="Cancel refresh"
                                    Command="{Binding RefreshPullRequestsCancelCommand}" IsVisible="{Binding IsPullRequestLoading}" />
                            <TextBlock Text="{Binding PullRequestAccountHint}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding HasPullRequestAccountHint}" />
                            <TextBlock Text="{Binding HostingStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                            <Button Classes="workspace toolbar" Content="Retry incomplete list"
                                    Command="{Binding LoadMorePullRequestsCommand}" IsVisible="{Binding HasMorePullRequests}" />
                            <Button Classes="workspace toolbar" Content="Pull request workspace…" Click="PullRequests_Click" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Issues"
                              IsExpanded="False">
                        <Button Classes="workspace toolbar"
                                Content="View issues…"
                                Click="Issues_Click"
                                HorizontalContentAlignment="Left" />
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation" IsExpanded="True">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Submodules" VerticalAlignment="Center" />

                                <Button x:Name="AddSubmoduleButton"
                                        Grid.Column="1"
                                        Classes="workspace toolbar"
                                        Content="＋"
                                        Click="AddSubmodule_Click"
                                        IsEnabled="{Binding HasRepository}"
                                        ToolTip.Tip="Add submodule"
                                        Padding="6,0"
                                        MinHeight="0" />
                            </Grid>
                        </Expander.Header>

                        <StackPanel>
                            <ListBox x:Name="SubmoduleList"
                                     ItemsSource="{Binding Submodules}"
                                     SelectedItem="{Binding SelectedSubmodule}"
                                     DoubleTapped="Submodule_DoubleTapped"
                                     ContextRequested="SubmoduleContextRequested"
                                     MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="20,*,Auto"
                                              ColumnSpacing="4"
                                              ToolTip.Tip="{Binding Path}">
                                            <Path Data="M 1,4 L 7,4 L 9,6 L 17,6 L 17,15 L 1,15 Z M 6,9 L 12,9 M 9,6.5 L 12,9 L 9,11.5"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Stroke="#AAB2BF"
                                                  StrokeThickness="1.4"
                                                  VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Summary}"
                                                       Classes="muted"
                                                       FontSize="11"
                                                       Margin="8,0,4,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No submodules in this repository."
                                       Classes="muted"
                                       FontSize="11"
                                       Margin="8,4"
                                       IsVisible="{Binding !HasSubmodules}" />
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation" IsExpanded="True">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Git LFS" VerticalAlignment="Center" />

                                <Button x:Name="TrackLfsButton"
                                        Grid.Column="1"
                                        Classes="workspace toolbar"
                                        Content="＋"
                                        Click="TrackLfs_Click"
                                        IsEnabled="{Binding HasRepository}"
                                        ToolTip.Tip="Track a file type with Git LFS"
                                        Padding="6,0"
                                        MinHeight="0" />
                            </Grid>
                        </Expander.Header>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding LfsWarning}"
                                       Classes="muted"
                                       FontSize="11"
                                       Margin="8,4"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasLfsWarning}" />

                            <Button Classes="workspace toolbar"
                                    Content="Set up Git LFS for this repository"
                                    Command="{Binding SetUpLfsCommand}"
                                    IsVisible="{Binding CanSetUpLfs}"
                                    HorizontalContentAlignment="Left" />

                            <ListBox x:Name="LfsPatternList"
                                     ItemsSource="{Binding LfsPatterns}"
                                     ContextRequested="LfsPatternContextRequested"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="6"
                                              ToolTip.Tip="{Binding ToolTip}">
                                            <TextBlock Text="{Binding Pattern}" TextTrimming="CharacterEllipsis" />

                                            <Path Grid.Column="1"
                                                  Data="M 3,7 L 3,4.5 A 3,3 0 0 1 9,4.5 L 9,7 M 1.5,7 L 10.5,7 L 10.5,13 L 1.5,13 Z"
                                                  Width="10"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="#AAB2BF"
                                                  StrokeThickness="1.3"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding Lockable}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No file types tracked. Use ＋ to store large files such as *.psd in Git LFS."
                                       Classes="muted"
                                       FontSize="11"
                                       Margin="8,4"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !UsesLfs}" />

                            <TextBlock Text="{Binding LfsSummary}"
                                       Classes="muted"
                                       FontSize="11"
                                       Margin="8,0" />

                            <Button Classes="workspace toolbar"
                                    Content="Download LFS files"
                                    Command="{Binding DownloadLfsFilesCommand}"
                                    IsVisible="{Binding CanDownloadLfs}"
                                    HorizontalContentAlignment="Left" />

                            <Button x:Name="PushAllLfsButton"
                                    Classes="workspace toolbar"
                                    Content="Push all LFS files"
                                    Command="{Binding PushAllLfsFilesCommand}"
                                    IsVisible="{Binding UsesLfs}"
                                    ToolTip.Tip="Upload LFS files for every branch and tag. Use this when others see missing LFS files after a push."
                                    HorizontalContentAlignment="Left" />

                            <Button x:Name="PruneLfsButton"
                                    Classes="workspace toolbar"
                                    Content="Free up disk space…"
                                    Click="PruneLfs_Click"
                                    IsVisible="{Binding UsesLfs}"
                                    ToolTip.Tip="Remove old LFS files from this computer that the server already has"
                                    HorizontalContentAlignment="Left" />

                            <Grid ColumnDefinitions="*,Auto"
                                  Margin="8,6,0,0"
                                  IsVisible="{Binding UsesLfs}">
                                <TextBlock Text="Locks"
                                           Classes="muted"
                                           FontSize="11"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="LockLfsFileButton"
                                            Classes="workspace toolbar"
                                            Content="Lock a file…"
                                            Click="LockLfsFile_Click"
                                            ToolTip.Tip="Lock a file before editing it"
                                            Padding="6,0"
                                            MinHeight="0" />

                                    <Button Classes="workspace toolbar"
                                            Content="⟳"
                                            Command="{Binding RefreshLfsLocksCommand}"
                                            ToolTip.Tip="Refresh locks from the server"
                                            Padding="6,0"
                                            MinHeight="0" />
                                </StackPanel>
                            </Grid>

                            <ListBox x:Name="LfsLockList"
                                     ItemsSource="{Binding LfsLocks}"
                                     ContextRequested="LfsLockContextRequested"
                                     IsVisible="{Binding HasLfsLocks}"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="16,*,Auto"
                                              ColumnSpacing="4"
                                              ToolTip.Tip="{Binding ToolTip}">
                                            <Path Data="M 3,7 L 3,4.5 A 3,3 0 0 1 9,4.5 L 9,7 M 1.5,7 L 10.5,7 L 10.5,13 L 1.5,13 Z"
                                                  Width="10"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Color}"
                                                  StrokeThickness="1.3"
                                                  VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Path}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Owner}"
                                                       Classes="muted"
                                                       FontSize="11"
                                                       Margin="6,0,4,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding LfsLocksMessage}"
                                       Classes="muted"
                                       FontSize="11"
                                       Margin="8,0"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasLfsLocksMessage}" />
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
