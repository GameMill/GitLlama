<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitLlama.Desktop.Views.RepositoryCreationDialog"
        Width="600"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock x:Name="Heading"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <TextBlock x:Name="Description"
                   Classes="muted"
                   TextWrapping="Wrap" />

        <StackPanel x:Name="CloneFields" Spacing="8">
            <TextBlock Text="Repository URL" Classes="section" />

            <TextBox x:Name="RepositoryUrl"
                     Text="{Binding CloneUrl}"
                     Watermark="https://github.com/owner/repository.git" />
        </StackPanel>

        <TextBlock Text="Local folder" Classes="section" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="DestinationFolder"
                     Text="{Binding NewRepositoryDestination}"
                     Watermark="Full path to the repository folder" />

            <Button Grid.Column="1"
                    Classes="workspace"
                    Content="Browse…"
                    Click="Browse_Click" />
        </Grid>

        <StackPanel x:Name="InitializeFields" Spacing="8">
            <TextBlock Text="Branch" Classes="section" />

            <TextBox x:Name="InitialBranch"
                     Text="{Binding NewRepositoryBranch}"
                     Watermark="main" />

            <CheckBox x:Name="InitialCommit"
                      Content="Create a first commit with a README"
                      IsChecked="{Binding NewRepositoryInitialCommit}" />

            <TextBlock Text="With a first commit the branch has history straight away, ready to push. Other files in the folder stay uncommitted for you to review."
                       Classes="muted"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Expander x:Name="Credentials"
                  Classes="navigation"
                  Header="Private repository credentials (optional)">
            <StackPanel Margin="0,8" Spacing="8">
                <TextBox Text="{Binding NetworkUsername}" Watermark="HTTPS username" />

                <TextBox Text="{Binding NetworkSecret}"
                         PasswordChar="●"
                         Watermark="Token/password (this session only)" />
            </StackPanel>
        </Expander>

        <TextBlock x:Name="Feedback"
                   TextWrapping="Wrap"
                   Classes="muted"
                   MaxHeight="100" />

        <TextBlock Text="{Binding NetworkProgressText}"
                   TextWrapping="Wrap"
                   Classes="muted"
                   IsVisible="{Binding IsNetworkBusy}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Classes="workspace"
                    Content="Cancel"
                    Click="Cancel_Click" />

            <Button x:Name="Submit"
                    Classes="workspace"
                    Click="Submit_Click" />
        </StackPanel>
    </StackPanel>
</Window>
